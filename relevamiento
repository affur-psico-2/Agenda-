function go(n) {
  cur = Math.max(0, Math.min(total - 1, n));
  book.style.transform = 'translateX(-' + (cur * 100) + 'vw)';
  update();
}

function update() {
  counter.textContent = String(cur + 1).padStart(2, '0') + ' / ' + String(total).padStart(2, '0');
  prog.style.width = ((cur + 1) / total * 100) + '%';
  btnPrev.classList.toggle('off', cur === 0);
  btnNext.classList.toggle('off', cur >= total - 1);

  // Adapt nav colors to current page
  const isDark = pages[cur].classList.contains('bk');
  const btnColor = isDark ? 'var(--crm)' : 'var(--blk)';
  btnPrev.style.color = btnColor;
  btnNext.style.color = btnColor;
  const navLogo = nav.querySelector('.nav-title');
  const navCtr  = nav.querySelector('.nav-counter');
  navLogo.style.color = isDark ? 'var(--lgt)' : 'var(--gry)';
  navCtr.style.color  = isDark ? 'var(--gry)' : '#aaa';
  prog.style.background = isDark ? 'var(--red)' : 'var(--rdk)';
}

// Keyboard
document.addEventListener('keydown', e => {
  if (e.key === 'ArrowRight' || e.key === 'ArrowDown') go(cur + 1);
  if (e.key === 'ArrowLeft'  || e.key === 'ArrowUp')   go(cur - 1);
});

// Touch
let tx = 0, ty = 0;
document.addEventListener('touchstart', e => {
  tx = e.touches[0].clientX;
  ty = e.touches[0].clientY;
}, { passive: true });
document.addEventListener('touchend', e => {
  const dx = e.changedTouches[0].clientX - tx;
  const dy = e.changedTouches[0].clientY - ty;
  if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.4) {
    dx < 0 ? go(cur + 1) : go(cur - 1);
  }
}, { passive: true });

// Mouse drag (desktop)
let mx = 0, dragging = false;
document.addEventListener('mousedown', e => { mx = e.clientX; dragging = true; });
document.addEventListener('mouseup', e => {
  if (!dragging) return;
  dragging = false;
  const dx = e.clientX - mx;
  if (Math.abs(dx) > 60) dx < 0 ? go(cur + 1) : go(cur - 1);
});

update();
</script>
</body>
</html>
