<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,500;1,300;1,400&amp;family=IBM+Plex+Serif:ital,wght@0,300;0,400;0,600;1,300;1,400&amp;display=swap" rel="stylesheet"/>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}

:root{
  --blk:#0f0f0f;
  --crm:#f4f1eb;
  --b1:#ece7de;
  --b2:#ddd7cc;
  --b3:#cfc8ba;
  --b4:#e5dfd4;
  --red:#d93420;
  --rdk:#a8280f;
  --gry:#6a6a6a;
  --lgt:#b8b4ac;
  --body-dk:#3a332c;
  --fns:'IBM Plex Sans',sans-serif;
  --fnr:'IBM Plex Serif',serif;
}

html,body{
  width:100%;height:100%;
  overflow:hidden;
  background:var(--blk);
  font-family:var(--fns);
  -webkit-font-smoothing:antialiased;
  -moz-osx-font-smoothing:grayscale;
}

/* ── FIXED NAV ── */
#top-nav{
  position:fixed;top:0;left:0;right:0;
  z-index:100;
  display:flex;align-items:center;justify-content:space-between;
  padding:.75rem 1.25rem;
  pointer-events:none;
}
.nav-title{
  font-family:var(--fns);
  font-size:.6rem;letter-spacing:.2em;text-transform:uppercase;
  color:var(--lgt);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
  max-width:55vw;
}
.nav-counter{
  font-family:var(--fns);
  font-size:.6rem;letter-spacing:.12em;
  color:var(--gry);white-space:nowrap;
}

/* ── PROGRESS ── */
#prog-bar{
  position:fixed;bottom:0;left:0;
  height:2px;width:0;
  background:var(--red);
  z-index:100;
  transition:width .3s ease;
}

/* ── BOTTOM NAV BUTTONS ── */
#ctrl{
  position:fixed;bottom:1.4rem;right:1.25rem;
  z-index:100;
  display:flex;gap:1.1rem;align-items:center;
}
.nbtn{
  display:flex;flex-direction:column;align-items:center;gap:.3rem;
  cursor:pointer;opacity:.7;transition:opacity .2s,transform .15s;
  background:none;border:none;padding:.3rem;
  color:var(--crm);user-select:none;
}
.nbtn:hover{opacity:1;transform:scale(1.1)}
.nbtn.off{opacity:0;pointer-events:none}
.nbtn svg{width:28px;height:28px}
.nbtn span{
  font-size:.58rem;letter-spacing:.17em;text-transform:uppercase;
  font-family:var(--fns);font-weight:500;color:inherit;
}

/* ── WRAP + BOOK ── */
#wrap{
  position:fixed;top:0;left:0;
  width:100vw;height:100dvh;
  overflow:hidden;
}
#book{
  display:flex;flex-direction:row;
  height:100%;
  will-change:transform;
  transition:transform .38s cubic-bezier(.25,.46,.45,.94);
}

/* ── PAGE BASE ── */
.pg{
  width:100vw;min-width:100vw;
  height:100%;
  flex-shrink:0;
  position:relative;
  overflow:hidden;
  display:flex;
  align-items:center;
  justify-content:center;
}

/* Page themes */
.bk{background:var(--blk);color:var(--crm)}
.c1{background:var(--crm);color:var(--blk)}
.c2{background:var(--b1);color:var(--blk)}
.c3{background:var(--b2);color:var(--blk)}
.c4{background:var(--b3);color:var(--blk)}
.c5{background:var(--b4);color:var(--blk)}

/* ── PAGE INNER ── */
.pgi{
  width:100%;
  max-width:660px;
  padding:4.5rem 1.5rem 5rem;
  margin:0 auto;
  height:100%;
  display:flex;
  flex-direction:column;
  justify-content:flex-start;
  overflow:hidden;
}
.pgi.mid{justify-content:center}

/* ── TYPOGRAPHY ── */

/* Small label above title */
.lbl{
  font-family:var(--fns);
  font-size:.58rem;letter-spacing:.22em;text-transform:uppercase;
  color:var(--rdk);margin-bottom:.9rem;display:block;
}
.bk .lbl{color:rgba(255,255,255,.45)}

/* Chapter separator big title */
.sep-num{
  font-family:var(--fns);
  font-size:.62rem;letter-spacing:.25em;text-transform:uppercase;
  color:rgba(255,255,255,.4);margin-bottom:1rem;display:block;
}
.sep-title{
  font-family:var(--fnr);
  font-size:clamp(1.9rem,7vw,3.2rem);
  font-weight:300;line-height:1.05;
  letter-spacing:-.02em;color:var(--crm);
  margin-bottom:.6rem;
}
.sep-sub{
  font-family:var(--fnr);
  font-size:clamp(.9rem,2.5vw,1.2rem);
  font-weight:300;font-style:italic;
  color:rgba(255,255,255,.5);
  margin-top:.5rem;
}

/* Section title */
h2{
  font-family:var(--fnr);
  font-size:clamp(1.15rem,3.5vw,1.7rem);
  font-weight:300;line-height:1.18;
  letter-spacing:-.015em;
  color:inherit;
  margin-bottom:.5rem;
}

/* Red rule */
.rl{
  width:2rem;height:1px;
  background:var(--rdk);
  margin:.75rem 0 1rem;
  flex-shrink:0;
}
.bk .rl{background:var(--red)}

/* Body text */
p{
  font-family:var(--fns);
  font-size:clamp(.88rem,1.25vw,.98rem);
  line-height:1.75;
  color:var(--body-dk);
}
.bk p{color:var(--lgt)}
p+p{margin-top:.85em}

/* Emphasized phrase (frase destacada) */
.hl{
  border-left:2px solid var(--rdk);
  padding-left:1rem;
  margin:1rem 0;
  font-family:var(--fns);
  font-size:clamp(.88rem,1.3vw,1rem);
  font-weight:500;
  line-height:1.6;
  color:var(--rdk);
}
.bk .hl{border-color:rgba(255,255,255,.3);color:var(--crm)}

/* Quote block (cita del colectivo) */
.qt{
  font-family:var(--fnr);
  font-size:clamp(1.15rem,3.2vw,1.7rem);
  font-style:italic;
  font-weight:300;
  line-height:1.42;
  color:var(--blk);
  margin:1.2rem 0 .6rem;
}
.bk .qt{color:var(--crm)}
.c2 .qt,.c3 .qt,.c4 .qt,.c5 .qt{color:var(--blk)}
.qa{
  font-family:var(--fns);
  font-size:.6rem;letter-spacing:.2em;text-transform:uppercase;
  color:var(--gry);margin-bottom:.5rem;
}

/* Quote mark decoration */
.qm{
  font-family:var(--fnr);
  font-size:3.5rem;line-height:.6;
  color:var(--red);opacity:.35;
  display:block;margin-bottom:.4rem;
}

/* Data number */
.dn{
  font-family:var(--fnr);
  font-size:clamp(2rem,6vw,3.4rem);
  font-weight:300;line-height:1;
  letter-spacing:-.03em;
  color:var(--rdk);
}
.bk .dn{color:var(--red)}
.dc{
  font-family:var(--fns);
  font-size:.78rem;line-height:1.5;
  color:var(--gry);margin-top:.3rem;
  max-width:38ch;
}
.c1 .dc,.c5 .dc{color:#6a6060}

/* Data pair (two numbers side by side) */
.dp{
  display:flex;gap:1.5rem;
  margin:1rem 0;
  flex-wrap:wrap;
}
.dp .di{flex:1;min-width:120px}
.dp .di .dn{font-size:clamp(1.6rem,5vw,2.6rem)}
.dp .di .lbl{margin-bottom:.25rem;font-size:.55rem}

/* Data bar */
.bar{margin:.5rem 0 .9rem;max-width:420px}
.bar-lbl{
  display:flex;justify-content:space-between;
  font-size:.68rem;color:var(--gry);letter-spacing:.03em;
  margin-bottom:.3rem;
}
.bar-track{height:4px;background:rgba(0,0,0,.1);position:relative;overflow:hidden;border-radius:2px}
.bar-fill{position:absolute;top:0;left:0;height:100%;background:var(--rdk);border-radius:2px}
.bar.alt .bar-fill{background:var(--gry)}

/* Chapter list items (Lo que cambiaríamos) */
.item{
  padding:.75rem 0;
  border-bottom:1px solid rgba(0,0,0,.1);
}
.item:last-child{border-bottom:none}
.item-title{
  font-family:var(--fns);
  font-size:.85rem;font-weight:500;
  color:var(--rdk);margin-bottom:.25rem;
}
.item p{font-size:.84rem;margin-top:0}

/* Divider between sub-sections within a page */
.sub-gap{margin-top:1.2rem;padding-top:1.2rem;border-top:1px solid rgba(0,0,0,.1)}

/* Cover accent */
.cover-rule{
  width:2.5rem;height:1px;
  background:var(--red);
  margin:.9rem auto 1rem;
}

/* Page number tag (corner) */
.pgn{
  position:absolute;top:2.8rem;right:1.25rem;
  font-size:.55rem;letter-spacing:.18em;text-transform:uppercase;
  color:rgba(255,255,255,.2);
}
.c1 .pgn,.c2 .pgn,.c3 .pgn,.c4 .pgn,.c5 .pgn{color:rgba(0,0,0,.15)}

/* ── MOBILE TWEAKS ── */
@media(max-width:520px){
  .pgi{padding:4.2rem 1.25rem 5rem}
  h2{font-size:clamp(1.1rem,5.5vw,1.5rem)}
  p{font-size:.9rem}
  .sep-title{font-size:clamp(1.7rem,8vw,2.6rem)}
  .dn{font-size:clamp(1.75rem,8vw,2.6rem)}
  .qt{font-size:clamp(1.1rem,5vw,1.5rem)}
  .dp{gap:1rem}
  .dp .di .dn{font-size:clamp(1.5rem,7vw,2.2rem)}
}


/* ── AIR / PHONE READING HELPERS ── */
.air-note{
  font-family:var(--fns);
  font-size:clamp(.86rem,1.22vw,.96rem);
  line-height:1.65;
  color:var(--body-dk);
  border-top:1px solid rgba(0,0,0,.12);
  border-bottom:1px solid rgba(0,0,0,.12);
  padding:.85rem 0;
  margin:1rem 0;
}
.bk .air-note{color:var(--lgt);border-color:rgba(255,255,255,.12)}
.air-stack{display:flex;flex-direction:column;gap:.85rem;margin-top:1rem}
.air-card{
  border-left:2px solid var(--rdk);
  padding-left:.9rem;
}
.air-card p{margin-top:.15rem;font-size:.88rem;line-height:1.6}
.air-card strong{color:var(--rdk);font-weight:600}
.bigline{
  font-family:var(--fnr);
  font-size:clamp(1.45rem,5.6vw,2.45rem);
  font-weight:300;
  line-height:1.18;
  letter-spacing:-.02em;
  color:var(--rdk);
}
.bk .bigline{color:var(--crm)}
.microcap{
  font-family:var(--fns);
  font-size:.56rem;
  letter-spacing:.2em;
  text-transform:uppercase;
  color:var(--gry);
  margin-top:.55rem;
}
.viz-legend{
  display:grid;
  gap:.45rem;
  margin-top:.7rem;
}
.viz-legend p{font-size:.76rem;line-height:1.45;margin:0;color:var(--gry)}
@media(max-width:520px){
  .air-stack{gap:.7rem}
  .air-card p{font-size:.86rem;line-height:1.55}
  .bigline{font-size:clamp(1.4rem,8vw,2.15rem)}
}
</style>
